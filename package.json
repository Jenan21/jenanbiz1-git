{
  "name": "jenanbiz-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:setup-env": "node scripts/setup-local-env.mjs",
    "academy:seed": "node --env-file=.env scripts/seed-academy-foundation.mjs",
    "verify:connections": "node scripts/verify-connections.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:global-standards": "node scripts/verify-global-standards.mjs",
    "verify:phase0-foundation": "node scripts/verify-phase0-foundation.mjs",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:academy": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/academy-foundation.integration.test.ts tests/integration/academy-dashboard.integration.test.ts tests/integration/academy-rbac.integration.test.ts tests/integration/academy-queue-sandbox.integration.test.ts tests/integration/academy-learner-certification.integration.test.ts",
    "test:e2e:academy-flows": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/academy-flow-routes.spec.ts --project=academy-flow-routes",
    "test:account": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/account-overview.integration.test.ts",
    "test:marketing": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/unit/marketing-flow-routes.test.ts tests/integration/marketing-domain.integration.test.ts",
    "test:e2e:marketing-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/marketing-full-flow.spec.ts --project=marketing-full-flow",
    "test:market": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/market-domain.integration.test.ts",
    "test:e2e:market-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/market-full-flow.spec.ts --project=market-full-flow",
    "test:studio": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/unit/studio-flow-routes.test.ts tests/integration/studio-documents.integration.test.ts",
    "test:e2e:studio-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/studio-full-flow.spec.ts --project=studio-full-flow",
    "test:programs": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/programs-domain.integration.test.ts",
    "test:projects": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/projects-domain.integration.test.ts",
    "test:e2e:project-flows": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/projects-flow-routes.spec.ts --project=projects-flow-routes",
    "test:robots": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/robot-coverage.integration.test.ts tests/integration/academy-foundation.integration.test.ts",
    "test:robotics": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/unit/robotics-flow-routes.test.ts tests/integration/public-robotics.integration.test.ts",
    "test:e2e:robotics-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/robotics-full-flow.spec.ts --project=robotics-full-flow",
    "test:e2e:admin-operations": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/admin-operations-full-flow.spec.ts --project=admin-operations-full-flow",
    "test:e2e:reports": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/report-pages.spec.ts --project=report-pages",
    "test:software": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/unit/pdf-engine.test.ts tests/unit/sheets-engine.test.ts tests/unit/visual-dna.test.ts",
    "test:software-erp": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/unit/software-flow-routes.test.ts tests/integration/software-sales.integration.test.ts tests/integration/software-operations.integration.test.ts tests/integration/software-hr.integration.test.ts",
    "test:e2e:software-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/software-full-flow.spec.ts --project=software-full-flow",
    "test:talent": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/unit/talent-flow-routes.test.ts tests/integration/talent-domain.integration.test.ts",
    "test:e2e:talent-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/talent-full-flow.spec.ts --project=talent-full-flow",
    "test:live-acceptance": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration/live-acceptance-001.integration.test.ts",
    "test:e2e": "node --env-file=.env scripts/run-playwright.mjs",
    "test:e2e:visual": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/visual-layout.spec.ts",
    "test:e2e:home-visual": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/home-visual.spec.ts --project=home-visual",
    "test:e2e:auth-visual": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/auth-visual.spec.ts --project=auth-visual-acceptance",
    "test:e2e:auth-flow": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/auth-flow-responsive.spec.ts --project=auth-flow-responsive",
    "test:e2e:user-center": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/user-center-responsive.spec.ts --project=user-center-responsive",
    "test:e2e:journey": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/platform-user-journey.spec.ts --project=platform-user-journey",
    "auth:bootstrap-super-admin": "node --env-file=.env scripts/bootstrap-super-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@svg-maps/world": "^2.0.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "node-vibrant": "^4.0.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "redis": "^6.2.1",
    "sharp": "^0.35.3",
    "svg-path-bbox": "^2.1.0",
    "world-countries": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 113",
    "Safari >= 16.2",
    "iOS >= 16.2",
    "Samsung >= 23"
  ],
  "engines": {
    "node": ">=20.9.0"
  }
}
