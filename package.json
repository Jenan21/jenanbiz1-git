{
  "name": "jenanbiz-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:setup-env": "node scripts/setup-local-env.mjs",
    "verify:connections": "node scripts/verify-connections.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:global-standards": "node scripts/verify-global-standards.mjs",
    "verify:phase0-foundation": "node scripts/verify-phase0-foundation.mjs",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/integration",
    "test:e2e": "node --env-file=.env scripts/run-playwright.mjs",
    "test:e2e:visual": "node --env-file=.env scripts/run-playwright.mjs tests/e2e/visual-layout.spec.ts",
    "auth:bootstrap-super-admin": "node --env-file=.env scripts/bootstrap-super-admin.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "node-vibrant": "^4.0.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
