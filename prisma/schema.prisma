model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  passwordHash               String?
  status                     UserStatus                  @default(PENDING)
  systemRole                 SystemRole                  @default(USER)
  emailVerifiedAt            DateTime?
  profile                    Profile?
  memberships                OrganizationMember[]
  sessions                   Session[]
  passwordResetTokens        PasswordResetToken[]
  notifications              Notification[]
  communityAccessGrants      CommunityAccessGrant[]
  auditLogs                  AuditLog[]                  @relation("AuditActor")
  hierarchyEntries           EmployeeHierarchy[]         @relation("HierarchyUser")
  supervisedEntries          EmployeeHierarchy[]         @relation("HierarchySupervisor")
  managedEntries             EmployeeHierarchy[]         @relation("HierarchyManager")
  uploadedFiles              FileAsset[]                 @relation("FileUploader")
  createdProjects            Project[]                   @relation("ProjectCreator")
  projectMemberships         ProjectMember[]             @relation("ProjectMemberUser")
  addedProjectMembers        ProjectMember[]             @relation("ProjectMemberAdder")
  mapProviderReviews         MapProviderReview[]         @relation("MapProviderReviewActor")
  projectAssessmentRevisions ProjectAssessmentRevision[] @relation("ProjectAssessmentRevisionAuthor")
  projectDecisions           ProjectDecision[]           @relation("ProjectDecisionMaker")
  projectFinancialPlans      ProjectFinancialPlan[]      @relation("ProjectFinancialPlanAuthor")
  marketListings             MarketListing[]             @relation("MarketListingCreator")
  marketInquiries            MarketInquiry[]             @relation("MarketInquiryRequester")
  marketNdaAcceptances       MarketNdaAcceptance[]
  marketViewingRequests      MarketViewingRequest[]
  marketOffers               MarketOffer[]
  fundingAssessments         FundingAssessment[]
  learnerEnrollments         LearnerEnrollment[]
  learnerLessonCompletions   LearnerLessonCompletion[]
  learnerExamAttempts        LearnerExamAttempt[]
  learnerCertificates        LearnerCertificate[]
  createdJobPostings         JobPosting[]                @relation("JobPostingCreator")
  jobApplications            JobApplication[]            @relation("JobApplicant")
  talentProfile              TalentProfile?
  marketingCampaigns         MarketingCampaign[]         @relation("MarketingCampaignCreator")
  payments                   Payment[]                   @relation("PaymentPayer")
  studioDocuments            StudioDocument[]            @relation("StudioDocumentOwner")
  robotInformationRequests   RobotInformationRequest[]
  academyStaffAssignments    AcademyStaffAssignment[]
  createdAcademyResources    AcademyResource[]           @relation("AcademyResourceCreator")
  approvedAcademyResources   AcademyResource[]           @relation("AcademyResourceApprover")
  academyResourceVersions    AcademyResourceVersion[]    @relation("AcademyResourceVersionAuthor")
  createdMissionRuns         MissionRun[]                @relation("MissionRunCreator")
  requestedMissionApprovals  MissionApproval[]           @relation("MissionApprovalRequester")
  decidedMissionApprovals    MissionApproval[]           @relation("MissionApprovalDecider")
  missionEscalations         MissionEscalation[]         @relation("MissionEscalationActor")
  missionHistoryEntries      MissionHistory[]            @relation("MissionHistoryActor")
  authoredKnowledgeVersions  KnowledgeVersion[]          @relation("KnowledgeVersionAuthor")
  approvedKnowledgeEntries   SharedKnowledge[]           @relation("KnowledgeApprover")
  knowledgeReviews           KnowledgeReview[]           @relation("KnowledgeReviewer")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
}

model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  locale      String    @default("ar")
  language    String    @default("ar")
  countryCode String?
  currency    String?
  timezone    String    @default("Asia/Riyadh")
  avatarUrl   String?
  accountType String?
  city        String?
  interests   Json?
  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Organization {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  members            OrganizationMember[]
  roles              Role[]
  subscriptions      Subscription[]
  payments           Payment[]
  files              FileAsset[]
  auditLogs          AuditLog[]
  projects           Project[]
  marketListings     MarketListing[]
  jobPostings        JobPosting[]
  marketingCampaigns MarketingCampaign[]
  businessPrograms   OrganizationProgram[]
  financialEntries   FinancialEntry[]
  softwareCustomers  SoftwareCustomer[]
  softwareProducts   SoftwareProduct[]
  salesDocuments     SalesDocument[]
  softwareReceipts   SoftwareReceipt[]
  crmLeads           CrmLead[]
  inventoryMovements InventoryMovement[]
  softwareEmployees  SoftwareEmployee[]
  payrollRuns        PayrollRun[]
  softwareSuppliers  SoftwareSupplier[]
  purchaseOrders     PurchaseOrder[]
  posShifts          PosShift[]
  fieldAssignments   FieldAssignment[]
  fleetVehicles      FleetVehicle[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

model OrganizationProgram {
  id             String                    @id @default(cuid())
  organizationId String
  key            OrganizationProgramKey
  status         OrganizationProgramStatus @default(ACTIVE)
  settings       Json?
  createdById    String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, status])
}

model FinancialEntry {
  id             String             @id @default(cuid())
  organizationId String
  type           FinancialEntryType
  amountMinor    Int
  currency       String             @default("SAR")
  description    String
  occurredAt     DateTime
  createdById    String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, occurredAt])
  @@index([organizationId, type])
}

model SoftwareCustomer {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  taxNumber      String?
  status         SoftwareCustomerStatus @default(ACTIVE)
  createdById    String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesDocuments SalesDocument[]
  leads          CrmLead[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, name])
}

model SoftwareProduct {
  id                 String              @id @default(cuid())
  organizationId     String
  sku                String
  name               String
  description        String?
  priceMinor         Int
  costMinor          Int                 @default(0)
  currency           String              @default("SAR")
  stockQuantity      Int                 @default(0)
  reorderLevel       Int                 @default(0)
  isActive           Boolean             @default(true)
  createdById        String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesLines         SalesDocumentLine[]
  purchaseLines      PurchaseOrderLine[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
}

model SalesDocument {
  id             String              @id @default(cuid())
  organizationId String
  customerId     String?
  posShiftId     String?
  kind           SalesDocumentKind
  status         SalesDocumentStatus @default(DRAFT)
  number         String
  currency       String              @default("SAR")
  subtotalMinor  Int
  taxMinor       Int
  totalMinor     Int
  issuedAt       DateTime            @default(now())
  dueAt          DateTime?
  notes          String?
  createdById    String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       SoftwareCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  posShift       PosShift?           @relation(fields: [posShiftId], references: [id], onDelete: SetNull)
  lines          SalesDocumentLine[]
  receipts       SoftwareReceipt[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, kind, status])
  @@index([customerId])
  @@index([posShiftId])
}

model SalesDocumentLine {
  id             String           @id @default(cuid())
  documentId     String
  productId      String?
  description    String
  quantity       Int
  unitPriceMinor Int
  taxRateBps     Int              @default(1500)
  lineTotalMinor Int
  document       SalesDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product        SoftwareProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@index([documentId])
  @@index([productId])
}

model SoftwareReceipt {
  id             String        @id @default(cuid())
  organizationId String
  documentId     String
  amountMinor    Int
  currency       String        @default("SAR")
  reference      String?
  receivedAt     DateTime      @default(now())
  createdById    String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId, receivedAt])
  @@index([documentId])
}

model CrmLead {
  id             String            @id @default(cuid())
  organizationId String
  customerId     String?
  name           String
  contact        String?
  source         String?
  valueMinor     Int?
  currency       String            @default("SAR")
  status         CrmLeadStatus     @default(NEW)
  nextAction     String?
  createdById    String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       SoftwareCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([customerId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  organizationId String
  productId      String
  type           InventoryMovementType
  quantity       Int
  note           String?
  referenceType  String?
  referenceId    String?
  occurredAt     DateTime              @default(now())
  createdById    String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        SoftwareProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())

  @@index([organizationId, occurredAt])
  @@index([productId, occurredAt])
}

model SoftwareEmployee {
  id             String                 @id @default(cuid())
  organizationId String
  memberId       String?                @unique
  employeeNumber String
  name           String
  email          String?
  roleTitle      String
  salaryMinor    Int                    @default(0)
  currency       String                 @default("SAR")
  status         SoftwareEmployeeStatus @default(ACTIVE)
  hiredAt        DateTime
  createdById    String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member         OrganizationMember?    @relation("SoftwareEmployeeMember", fields: [memberId], references: [id], onDelete: SetNull)
  attendance     AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  payrollItems   PayrollItem[]
  reviews        PerformanceReview[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, status])
}

model AttendanceRecord {
  id         String                 @id @default(cuid())
  employeeId String
  date       DateTime
  status     AttendanceRecordStatus
  checkInAt  DateTime?
  checkOutAt DateTime?
  note       String?
  employee   SoftwareEmployee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([employeeId, date])
  @@index([date, status])
}

model LeaveRequest {
  id         String             @id @default(cuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveRequestStatus @default(PENDING)
  employee   SoftwareEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model PayrollRun {
  id              String           @id @default(cuid())
  organizationId  String
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollRunStatus @default(DRAFT)
  totalGrossMinor Int
  totalNetMinor   Int
  postedAt        DateTime?
  createdById     String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items           PayrollItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, periodEnd])
  @@index([organizationId, status])
}

model PayrollItem {
  id              String           @id @default(cuid())
  payrollRunId    String
  employeeId      String
  grossMinor      Int
  deductionsMinor Int              @default(0)
  netMinor        Int
  payrollRun      PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        SoftwareEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PerformanceReview {
  id          String           @id @default(cuid())
  employeeId  String
  score       Int
  summary     String
  period      String
  reviewedAt  DateTime         @default(now())
  createdById String
  employee    SoftwareEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@index([employeeId, reviewedAt])
}

model SoftwareSupplier {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  createdById    String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, name])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  supplierId     String?
  number         String
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("SAR")
  totalMinor     Int
  expectedAt     DateTime?
  receivedAt     DateTime?
  createdById    String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       SoftwareSupplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines          PurchaseOrderLine[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String           @id @default(cuid())
  purchaseOrderId String
  productId       String?
  description     String
  quantity        Int
  unitCostMinor   Int
  lineTotalMinor  Int
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         SoftwareProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

model PosShift {
  id               String          @id @default(cuid())
  organizationId   String
  status           PosShiftStatus  @default(OPEN)
  openingCashMinor Int             @default(0)
  closingCashMinor Int?
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  openedById       String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales            SalesDocument[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([openedAt])
}

model FieldAssignment {
  id               String              @id @default(cuid())
  organizationId   String
  assigneeMemberId String?
  title            String
  description      String?
  status           TaskStatus          @default(DRAFT)
  dueAt            DateTime?
  createdById      String
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeMember   OrganizationMember? @relation("FieldAssignmentAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([assigneeMemberId, status])
}

model FleetVehicle {
  id             String             @id @default(cuid())
  organizationId String
  label          String
  plateNumber    String
  status         FleetVehicleStatus @default(ACTIVE)
  createdById    String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
}

model EmployeeHierarchy {
  id           String   @id @default(cuid())
  userId       String   @unique
  supervisorId String?
  managerId    String?
  level        String
  user         User     @relation("HierarchyUser", fields: [userId], references: [id], onDelete: Cascade)
  supervisor   User?    @relation("HierarchySupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  manager      User?    @relation("HierarchyManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
  @@index([managerId])
}

model OrganizationMember {
  id               String                   @id @default(cuid())
  organizationId   String
  userId           String
  roleId           String?
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role?                    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status           OrganizationMemberStatus @default(INVITED)
  isOwner          Boolean                  @default(false)
  joinedAt         DateTime?
  fieldAssignments FieldAssignment[]        @relation("FieldAssignmentAssignee")
  softwareEmployee SoftwareEmployee?        @relation("SoftwareEmployeeMember")
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id             String               @id @default(cuid())
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String
  isSystem       Boolean              @default(false)
  members        OrganizationMember[]
  permissions    RolePermission[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
}

model CommunityAccessGrant {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  CommunitySocialPlatform
  status    CommunityAccessStatus   @default(ACTIVE)
  grantedAt DateTime                @default(now())
  revokedAt DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([userId, platform])
  @@index([userId, status])
}

model PlatformSocialLink {
  id        String                  @id @default(cuid())
  platform  CommunitySocialPlatform @unique
  url       String
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  description   String?
  priceMinor    Int
  currency      String         @default("SAR")
  billingPeriod String
  isActive      Boolean        @default(true)
  features      Json?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)
  externalRef    String?            @unique
  currentStart   DateTime
  currentEnd     DateTime
  canceledAt     DateTime?
  payments       Payment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([planId])
}

model Payment {
  id                String             @id @default(cuid())
  organizationId    String?
  payerUserId       String?
  subscriptionId    String?
  marketingCampaign MarketingCampaign? @relation("MarketingCampaignPayment")
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payerUser         User?              @relation("PaymentPayer", fields: [payerUserId], references: [id], onDelete: Restrict)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountMinor       Int
  currency          String             @default("SAR")
  status            PaymentStatus      @default(PENDING)
  provider          String?
  externalRef       String?            @unique
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([payerUserId, status])
  @@index([subscriptionId])
}

model StudioDocument {
  id              String                  @id @default(cuid())
  ownerId         String
  kind            StudioDocumentKind
  title           String
  content         Json
  currentVersion  Int                     @default(1)
  owner           User                    @relation("StudioDocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions        StudioDocumentVersion[]
  talentProfile   TalentProfile?          @relation("TalentProfileCv")
  jobApplications JobApplication[]        @relation("JobApplicationCv")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([ownerId, kind, updatedAt])
}

model StudioDocumentVersion {
  id         String         @id @default(cuid())
  documentId String
  version    Int
  title      String
  content    Json
  document   StudioDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model FileAsset {
  id               String                @id @default(cuid())
  organizationId   String?
  projectId        String?
  marketListingId  String?
  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?              @relation("ProjectEvidenceFiles", fields: [projectId], references: [id], onDelete: Cascade)
  marketListing    MarketListing?        @relation(fields: [marketListingId], references: [id], onDelete: Cascade)
  uploadedById     String?
  uploadedBy       User?                 @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  storageKey       String                @unique
  fileName         String
  mimeType         String
  sizeBytes        BigInt
  checksum         String?
  marketVisibility MarketFileVisibility?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([marketListingId])
  @@index([uploadedById])
}

model Robot {
  id                      String                    @id @default(cuid())
  name                    String
  slug                    String                    @unique
  team                    String?
  intelligence            Int                       @default(0)
  skill                   Int                       @default(0)
  experience              Int                       @default(0)
  status                  RobotStatus               @default(PENDING)
  isVisible               Boolean                   @default(false)
  notes                   String?
  tasks                   RobotTask[]
  reviews                 CommitteeReview[]
  missions                Mission[]
  evidence                Evidence[]
  costs                   CostRecord[]
  learningLogs            LearningLog[]
  evolutions              RobotEvolution[]
  modelRuns               ModelExecution[]
  genomeId                String?
  genome                  AgentGenome?              @relation(fields: [genomeId], references: [id], onDelete: SetNull)
  academicProfile         RobotAcademicProfile?
  runtimeAllocations      AgentRuntimeAllocation[]
  academyStaffAssignments AcademyStaffAssignment[]
  informationRequests     RobotInformationRequest[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status])
  @@index([isVisible])
}

model RobotTask {
  id                 String                   @id @default(cuid())
  robotId            String
  robot              Robot                    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             TaskStatus               @default(DRAFT)
  priority           String?                  @default("MEDIUM")
  dueAt              DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  missionId          String?
  mission            Mission?                 @relation(fields: [missionId], references: [id], onDelete: SetNull)
  evidence           Evidence[]
  costs              CostRecord[]
  learningLogs       LearningLog[]
  runtimeAllocations AgentRuntimeAllocation[]
  marketingCampaign  MarketingCampaign?       @relation("MarketingCampaignTask")

  @@index([robotId, status])
}

model RobotInformationRequest {
  id          String                        @id @default(cuid())
  requesterId String
  robotId     String
  task        String
  sector      String?
  location    String?
  environment String?
  budgetMinor Int?
  status      RobotInformationRequestStatus @default(REQUESTED)
  requester   User                          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  robot       Robot                         @relation(fields: [robotId], references: [id], onDelete: Cascade)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([requesterId, status, createdAt])
  @@index([robotId, status, createdAt])
}

model Mission {
  id                   String                   @id @default(cuid())
  name                 String
  description          String?
  status               TaskStatus               @default(DRAFT)
  requiredIntelligence Int                      @default(0)
  assignedRobots       Robot[]
  tasks                RobotTask[]
  costs                CostRecord[]
  evidence             Evidence[]
  learningLogs         LearningLog[]
  knowledgeEntries     SharedKnowledge[]
  runtimeAllocations   AgentRuntimeAllocation[]
  runs                 MissionRun[]
  retryPolicy          MissionRetryPolicy?
  fallbackPolicies     MissionFallbackPolicy[]
  history              MissionHistory[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
}

model MissionRun {
  id             String              @id @default(cuid())
  missionId      String
  createdById    String?
  status         MissionRunStatus    @default(CREATED)
  traceId        String              @unique
  currentAttempt Int                 @default(0)
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  lastError      String?
  mission        Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  createdBy      User?               @relation("MissionRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subtasks       MissionSubtask[]
  dependencies   MissionDependency[]
  attempts       MissionAttempt[]
  approvals      MissionApproval[]
  escalations    MissionEscalation[]
  history        MissionHistory[]
  evidence       Evidence[]
  costs          CostRecord[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([missionId, status, createdAt])
}

model MissionSubtask {
  id           String               @id @default(cuid())
  runId        String
  parentId     String?
  key          String
  title        String
  description  String?
  status       MissionSubtaskStatus @default(PENDING)
  priority     Int                  @default(0)
  sequence     Int                  @default(0)
  maxAttempts  Int                  @default(3)
  run          MissionRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  parent       MissionSubtask?      @relation("MissionSubtaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     MissionSubtask[]     @relation("MissionSubtaskTree")
  predecessors MissionDependency[]  @relation("MissionDependencyPredecessor")
  successors   MissionDependency[]  @relation("MissionDependencySuccessor")
  attempts     MissionAttempt[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([runId, key])
  @@index([runId, status, sequence])
  @@index([parentId])
}

model MissionDependency {
  id            String                @id @default(cuid())
  runId         String
  predecessorId String
  successorId   String
  type          MissionDependencyType @default(REQUIRES)
  condition     Json?
  run           MissionRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  predecessor   MissionSubtask        @relation("MissionDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     MissionSubtask        @relation("MissionDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())

  @@unique([predecessorId, successorId])
  @@index([runId])
  @@index([successorId])
}

model MissionAttempt {
  id               String                 @id @default(cuid())
  runId            String
  subtaskId        String?
  fallbackPolicyId String?
  attempt          Int
  attemptKey       String                 @unique
  status           MissionAttemptStatus   @default(RUNNING)
  provider         String?
  model            String?
  output           Json?
  error            String?
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  run              MissionRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  subtask          MissionSubtask?        @relation(fields: [subtaskId], references: [id], onDelete: SetNull)
  fallbackPolicy   MissionFallbackPolicy? @relation(fields: [fallbackPolicyId], references: [id], onDelete: SetNull)
  evidence         Evidence[]
  costs            CostRecord[]

  @@index([runId, attempt])
  @@index([subtaskId, attempt])
}

model MissionRetryPolicy {
  id                  String              @id @default(cuid())
  missionId           String              @unique
  maxAttempts         Int                 @default(3)
  backoff             MissionRetryBackoff @default(EXPONENTIAL)
  baseDelaySeconds    Int                 @default(30)
  maximumDelaySeconds Int                 @default(3600)
  retryableErrors     Json?
  active              Boolean             @default(true)
  mission             Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model MissionFallbackPolicy {
  id        String           @id @default(cuid())
  missionId String
  name      String
  priority  Int              @default(0)
  provider  String?
  model     String?
  toolId    String?
  condition Json?
  active    Boolean          @default(true)
  mission   Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  attempts  MissionAttempt[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([missionId, priority])
  @@index([missionId, active, priority])
}

model MissionApproval {
  id            String                @id @default(cuid())
  runId         String
  requestedById String?
  decidedById   String?
  gate          String
  status        MissionApprovalStatus @default(PENDING)
  rationale     String?
  requestedAt   DateTime              @default(now())
  decidedAt     DateTime?
  run           MissionRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  requestedBy   User?                 @relation("MissionApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy     User?                 @relation("MissionApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  escalations   MissionEscalation[]

  @@index([runId, status, requestedAt])
}

model MissionEscalation {
  id           String                  @id @default(cuid())
  runId        String
  approvalId   String?
  actorId      String?
  level        Int                     @default(1)
  reason       String
  assignedRole SystemRole?
  status       MissionEscalationStatus @default(OPEN)
  resolvedAt   DateTime?
  run          MissionRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval     MissionApproval?        @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  actor        User?                   @relation("MissionEscalationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([runId, status, createdAt])
  @@index([approvalId])
}

model MissionHistory {
  id         String            @id @default(cuid())
  missionId  String
  runId      String?
  actorId    String?
  event      String
  fromStatus MissionRunStatus?
  toStatus   MissionRunStatus?
  traceId    String?
  metadata   Json?
  mission    Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  run        MissionRun?       @relation(fields: [runId], references: [id], onDelete: Cascade)
  actor      User?             @relation("MissionHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([missionId, createdAt])
  @@index([runId, createdAt])
  @@index([traceId])
}

model Evidence {
  id             String                  @id @default(cuid())
  robotId        String
  robotTaskId    String?
  missionId      String?
  missionRunId   String?
  attemptId      String?
  type           String
  description    String
  metadata       Json?
  verified       Boolean                 @default(false)
  robot          Robot                   @relation(fields: [robotId], references: [id], onDelete: Cascade)
  robotTask      RobotTask?              @relation(fields: [robotTaskId], references: [id], onDelete: Cascade)
  mission        Mission?                @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionRun     MissionRun?             @relation(fields: [missionRunId], references: [id], onDelete: SetNull)
  attempt        MissionAttempt?         @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  knowledgeLinks KnowledgeEvidenceLink[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([robotId, verified])
  @@index([robotTaskId])
  @@index([missionId])
  @@index([missionRunId, createdAt])
  @@index([attemptId])
}

model CostRecord {
  id                String          @id @default(cuid())
  robotId           String?
  robotTaskId       String?
  missionId         String?
  missionRunId      String?
  attemptId         String?
  provider          String
  model             String?
  inputTokens       Int             @default(0)
  outputTokens      Int             @default(0)
  computeCostMinor  Int             @default(0)
  currency          String          @default("USD")
  estimatedDuration Int?
  actualDuration    Int?
  robot             Robot?          @relation(fields: [robotId], references: [id], onDelete: SetNull)
  robotTask         RobotTask?      @relation(fields: [robotTaskId], references: [id], onDelete: SetNull)
  mission           Mission?        @relation(fields: [missionId], references: [id], onDelete: SetNull)
  missionRun        MissionRun?     @relation(fields: [missionRunId], references: [id], onDelete: SetNull)
  attempt           MissionAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@index([robotId, createdAt])
  @@index([missionId, createdAt])
  @@index([missionRunId, createdAt])
  @@index([attemptId])
}

model LearningLog {
  id          String     @id @default(cuid())
  robotId     String
  robotTaskId String?
  missionId   String?
  signal      String
  scoreBefore Int        @default(0)
  scoreAfter  Int        @default(0)
  feedback    String?
  robot       Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  robotTask   RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: SetNull)
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([robotId, createdAt])
}

model RobotEvolution {
  id                String   @id @default(cuid())
  robotId           String
  generation        Int
  intelligenceDelta Int      @default(0)
  skillDelta        Int      @default(0)
  experienceDelta   Int      @default(0)
  reason            String
  robot             Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([robotId, generation])
  @@index([robotId, createdAt])
}

model SharedKnowledge {
  id                String                  @id @default(cuid())
  title             String
  content           String
  source            String
  sourceUrl         String?
  sourcePublishedAt DateTime?
  confidence        Int                     @default(0)
  currentVersion    Int                     @default(1)
  approvalState     KnowledgeApprovalState  @default(DRAFT)
  approvedById      String?
  approvedAt        DateTime?
  missionId         String?
  mission           Mission?                @relation(fields: [missionId], references: [id], onDelete: SetNull)
  approvedBy        User?                   @relation("KnowledgeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  academyExperience AcademicExperience?
  versions          KnowledgeVersion[]
  reviews           KnowledgeReview[]
  evidenceLinks     KnowledgeEvidenceLink[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([confidence, approvalState])
}

model KnowledgeVersion {
  id                String                  @id @default(cuid())
  knowledgeId       String
  authorId          String?
  version           Int
  title             String
  content           String
  source            String
  sourceUrl         String?
  sourcePublishedAt DateTime?
  confidence        Int                     @default(0)
  approvalState     KnowledgeApprovalState  @default(DRAFT)
  references        Json?
  changeSummary     String?
  rollbackFrom      Int?
  knowledge         SharedKnowledge         @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  author            User?                   @relation("KnowledgeVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reviews           KnowledgeReview[]
  evidenceLinks     KnowledgeEvidenceLink[]
  createdAt         DateTime                @default(now())

  @@unique([knowledgeId, version])
  @@index([knowledgeId, createdAt])
  @@index([approvalState])
}

model KnowledgeReview {
  id          String                 @id @default(cuid())
  knowledgeId String
  versionId   String
