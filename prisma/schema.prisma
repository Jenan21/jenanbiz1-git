  leaseToken     String?
  leaseExpiresAt DateTime?
  attempts       Int                    @default(0)
  maxAttempts    Int                    @default(3)
  lastError      String?
  queue          AcademyWorkQueue       @relation(fields: [queueId], references: [id], onDelete: Cascade)
  profile        RobotAcademicProfile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([queueId, status, priority, availableAt])
  @@index([profileId, kind])
  @@index([leaseExpiresAt])
}

model SandboxLabRun {
  id             String               @id @default(cuid())
  profileId      String
  labId          String
  idempotencyKey String               @unique
  status         SandboxLabRunStatus  @default(QUEUED)
  providerState  AIProviderReadiness  @default(NOT_REQUIRED)
  input          Json?
  output         Json?
  evidence       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  profile        RobotAcademicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  lab            AcademyLab           @relation(fields: [labId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, providerState])
  @@index([profileId, labId])
}

model AgentLanguageProficiency {
  profileId        String
  languageCode     String
  proficiency      SkillProficiencyLevel @default(TRAINEE)
  businessLanguage Boolean               @default(false)
  localTerminology Boolean               @default(false)
  profile          RobotAcademicProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@id([profileId, languageCode])
  @@index([languageCode, proficiency])
}

model AgentGenomeCapability {
  id        String               @id @default(cuid())
  genomeId  String
  type      GenomeCapabilityType
  key       String
  version   String?
  metadata  Json?
  genome    AgentGenome          @relation(fields: [genomeId], references: [id], onDelete: Cascade)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([genomeId, type, key])
  @@index([type, key])
}
