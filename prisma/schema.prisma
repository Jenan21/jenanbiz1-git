generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SystemRole {
  USER
  EMPLOYEE
  SUPERVISOR
  MANAGER
  ELITE_COMMITTEE
  ADMIN
  SUPER_ADMIN
}

enum RobotStatus {
  PENDING
  ACTIVE
  REVIEW
  HIDDEN
  ARCHIVED
}

enum TaskStatus {
  DRAFT
  ACTIVE
  PENDING_APPROVAL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewVerdict {
  APPROVE
  DEFER
  REJECT
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String?
  status          UserStatus           @default(PENDING)
  systemRole      SystemRole           @default(USER)
  emailVerifiedAt DateTime?
  profile         Profile?
  memberships     OrganizationMember[]
  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]           @relation("AuditActor")
  hierarchyEntries EmployeeHierarchy[] @relation("HierarchyUser")
  supervisedEntries EmployeeHierarchy[] @relation("HierarchySupervisor")
  managedEntries EmployeeHierarchy[] @relation("HierarchyManager")
  uploadedFiles   FileAsset[]          @relation("FileUploader")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  locale      String   @default("ar")
  language    String   @default("ar")
  countryCode String?
  currency    String?
  timezone    String   @default("Asia/Riyadh")
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  members       OrganizationMember[]
  roles         Role[]
  subscriptions Subscription[]
  payments      Payment[]
  files         FileAsset[]
  auditLogs     AuditLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model EmployeeHierarchy {
  id           String   @id @default(cuid())
  userId       String   @unique
  supervisorId String?
  managerId    String?
  level        String
  user         User     @relation("HierarchyUser", fields: [userId], references: [id], onDelete: Cascade)
  supervisor   User?    @relation("HierarchySupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  manager      User?    @relation("HierarchyManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
  @@index([managerId])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String?
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role?                    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status         OrganizationMemberStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id             String               @id @default(cuid())
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String
  isSystem       Boolean              @default(false)
  members        OrganizationMember[]
  permissions    RolePermission[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  description   String?
  priceMinor    Int
  currency      String         @default("SAR")
  billingPeriod String
  isActive      Boolean        @default(true)
  features      Json?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)
  externalRef    String?            @unique
  currentStart   DateTime
  currentEnd     DateTime
  canceledAt     DateTime?
  payments       Payment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([planId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountMinor    Int
  currency       String        @default("SAR")
  status         PaymentStatus @default(PENDING)
  provider       String?
  externalRef    String?       @unique
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([subscriptionId])
}

model FileAsset {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String?
  uploadedBy     User?         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  storageKey     String        @unique
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  checksum       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([uploadedById])
}

model Robot {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  team        String?
  intelligence Int        @default(0)
  skill       Int         @default(0)
  experience  Int         @default(0)
  status      RobotStatus @default(PENDING)
  isVisible   Boolean     @default(false)
  notes       String?
  tasks       RobotTask[]
  reviews     CommitteeReview[]
  missions    Mission[]
  evidence    Evidence[]
  costs       CostRecord[]
  learningLogs LearningLog[]
  evolutions  RobotEvolution[]
  modelRuns   ModelExecution[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([isVisible])
}

model RobotTask {
  id          String    @id @default(cuid())
  robotId     String
  robot       Robot     @relation(fields: [robotId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(DRAFT)
  priority    String?   @default("MEDIUM")
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  missionId   String?
  mission     Mission?  @relation(fields: [missionId], references: [id], onDelete: SetNull)
  evidence    Evidence[]
  costs       CostRecord[]
  learningLogs LearningLog[]
  @@index([robotId, status])
}

model Mission {
  id                   String          @id @default(cuid())
  name                 String
  description          String?
  status               TaskStatus      @default(DRAFT)
  requiredIntelligence Int             @default(0)
  assignedRobots       Robot[]
  tasks                RobotTask[]
  costs                CostRecord[]
  evidence             Evidence[]
  learningLogs         LearningLog[]
  knowledgeEntries     SharedKnowledge[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
}

model Evidence {
  id          String     @id @default(cuid())
  robotId     String
  robotTaskId String?
  missionId   String?
  type        String
  description String
  metadata    Json?
  verified    Boolean    @default(false)
  robot       Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  robotTask   RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: Cascade)
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([robotId, verified])
  @@index([robotTaskId])
  @@index([missionId])
}

model CostRecord {
  id               String     @id @default(cuid())
  robotId          String?
  robotTaskId      String?
  missionId        String?
  provider         String
  model            String?
  inputTokens      Int        @default(0)
  outputTokens     Int        @default(0)
  computeCostMinor Int        @default(0)
  currency         String     @default("USD")
  estimatedDuration Int?
  actualDuration   Int?
  robot            Robot?     @relation(fields: [robotId], references: [id], onDelete: SetNull)
  robotTask        RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: SetNull)
  mission          Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())

  @@index([robotId, createdAt])
  @@index([missionId, createdAt])
}

model LearningLog {
  id          String     @id @default(cuid())
  robotId     String
  robotTaskId String?
  missionId   String?
  signal      String
  scoreBefore Int        @default(0)
  scoreAfter  Int        @default(0)
  feedback    String?
  robot       Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  robotTask   RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: SetNull)
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([robotId, createdAt])
}

model RobotEvolution {
  id              String   @id @default(cuid())
  robotId         String
  generation      Int
  intelligenceDelta Int     @default(0)
  skillDelta      Int       @default(0)
  experienceDelta Int       @default(0)
  reason          String
  robot           Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([robotId, generation])
  @@index([robotId, createdAt])
}

model SharedKnowledge {
  id          String   @id @default(cuid())
  title       String
  content     String
  source      String
  confidence  Int      @default(0)
  missionId   String?
  mission     Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([confidence])
}

model ModelExecution {
  id            String   @id @default(cuid())
  robotId       String?
  provider      String
  model         String
  taskType      String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  latencyMs     Int      @default(0)
  success       Boolean  @default(false)
  robot         Robot?   @relation(fields: [robotId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([provider, model, createdAt])
}

model CommitteeReview {
  id          String       @id @default(cuid())
  robotId     String
  robot       Robot        @relation(fields: [robotId], references: [id], onDelete: Cascade)
  reviewer    String
  score       Int          @default(0)
  verdict     ReviewVerdict @default(DEFER)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([robotId, verdict])
}
