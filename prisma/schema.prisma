generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SystemRole {
  USER
  EMPLOYEE
  SUPERVISOR
  MANAGER
  ELITE_COMMITTEE
  ADMIN
  SUPER_ADMIN
}

enum RobotStatus {
  PENDING
  ACTIVE
  REVIEW
  HIDDEN
  ARCHIVED
}

enum TaskStatus {
  DRAFT
  ACTIVE
  PENDING_APPROVAL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  ANALYSIS
  FEASIBILITY
  EVALUATION
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  REJECTED
  ARCHIVED
}

enum ProjectPhaseType {
  ANALYSIS
  FEASIBILITY
  EVALUATION
  PLANNING
  EXECUTION
  REVIEW
  COMPLETION
}

enum ProjectPhaseStatus {
  PENDING
  ACTIVE
  COMPLETED
  BLOCKED
  SKIPPED
}

enum ProjectAssessmentType {
  MARKET
  FINANCIAL
  OPERATIONAL
  RISK
  TECHNICAL
  COMPLIANCE
}

enum ReviewVerdict {
  APPROVE
  DEFER
  REJECT
}

enum AcademyLifecycleStatus {
  CANDIDATE
  ACCEPTED
  ENROLLED
  STUDYING
  THEORY_QUALIFIED
  THEORY_EXAM
  LAB
  PRACTICAL_QUALIFIED
  PRACTICAL_EXAM
  BLIND_CHALLENGE
  SPECIALIZATION_PROJECT
  CERTIFICATION_REVIEW
  CERTIFIED
  PROBATION
  OPERATIONAL
  FAILED
  REMEDIAL_TRAINING
  REDIRECTED
  SUSPENDED
  REJECTED
  RETIRED
}

enum SkillProficiencyLevel {
  TRAINEE
  JUNIOR
  QUALIFIED
  ADVANCED
  EXPERT
  ELITE
}

enum AcademicAssessmentType {
  THEORY
  PRACTICAL
  BLIND
  REAL_WORLD
}

enum AcademicAssessmentOutcome {
  PENDING
  PASSED
  FAILED
}

enum CourseProgressStatus {
  ASSIGNED
  COMPLETED
  FAILED
}

enum CertificationRecordStatus {
  PENDING
  CERTIFIED
  RECERTIFICATION_REQUIRED
  EXPIRED
  SUSPENDED
  REVOKED
}

enum RetrainingStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AIProviderReadiness {
  NOT_REQUIRED
  AWAITING_AI_PROVIDER
  READY
}

enum WorkforceDemandStatus {
  OPEN
  PAUSED
  FILLED
}

enum SkillRelationType {
  RELATED
  REQUIRED_TOOL
  REQUIRED_KNOWLEDGE
  REQUIRED_CERTIFICATION
}

enum SkillRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AcademyProgramStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CurriculumVersionStatus {
  DRAFT
  REVIEW
  APPROVED
  RETIRED
  ROLLED_BACK
}

enum CandidateBatchStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  PAUSED
}

enum AcademyCohortStatus {
  PLANNED
  OPEN
  ACTIVE
  COMPLETED
  PAUSED
}

enum WorkforceGapStatus {
  OPEN
  PLANNED
  FILLED
  PAUSED
}

enum RuntimeAllocationStatus {
  ALLOCATED
  RELEASED
  FAILED
}

enum GeographyNodeType {
  WORLD
  COUNTRY
  STATE
  REGION
  CITY
  DISTRICT
  TOWN
  VILLAGE
  LOCAL_ZONE
  CUSTOM
}

enum GeographicKnowledgeState {
  VERIFIED
  HIGH_CONFIDENCE
  ESTIMATED
  OUTDATED
  UNKNOWN
}

enum GeographicSourceType {
  PUBLIC
  LICENSED
  AUTHORIZED
  AGGREGATED
  ANONYMIZED
}

enum CurriculumChangeStatus {
  PROPOSED
  UNDER_REVIEW
  APPROVED
  REJECTED
  APPLIED
  ROLLED_BACK
}

enum AcademicReviewRole {
  INSTRUCTOR
  EXAMINER
  INDEPENDENT_REVIEWER
  CERTIFICATION_MANAGER
}

enum AcademyRoleScope {
  ADMIN
  CURRICULUM_MANAGER
  INSTRUCTOR
  EXAMINER
  REVIEWER
  CERTIFICATION_MANAGER
  WORKFORCE_MANAGER
  GEOGRAPHIC_INTELLIGENCE_MANAGER
  READ_ONLY_AUDITOR
}

enum AcademyQueueKind {
  ADMISSION
  ENROLLMENT
  EXAMINATION
  CERTIFICATION
  RETRAINING
  RECERTIFICATION
  CURRICULUM_CHANGE
  GEOGRAPHY_REFRESH
}

enum AcademyQueueItemStatus {
  PENDING
  LEASED
  COMPLETED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum SandboxLabRunStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  CANCELLED
  AWAITING_AI_PROVIDER
}

enum GenomeCapabilityType {
  ROLE
  GEOGRAPHY
  LANGUAGE
  PERMISSION
  TOOL
  MODEL_POLICY
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String?
  status                  UserStatus               @default(PENDING)
  systemRole              SystemRole               @default(USER)
  emailVerifiedAt         DateTime?
  profile                 Profile?
  memberships             OrganizationMember[]
  sessions                Session[]
  notifications           Notification[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  hierarchyEntries        EmployeeHierarchy[]      @relation("HierarchyUser")
  supervisedEntries       EmployeeHierarchy[]      @relation("HierarchySupervisor")
  managedEntries          EmployeeHierarchy[]      @relation("HierarchyManager")
  uploadedFiles           FileAsset[]              @relation("FileUploader")
  createdProjects         Project[]                @relation("ProjectCreator")
  academyStaffAssignments AcademyStaffAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  locale      String   @default("ar")
  language    String   @default("ar")
  countryCode String?
  currency    String?
  timezone    String   @default("Asia/Riyadh")
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Organization {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  members       OrganizationMember[]
  roles         Role[]
  subscriptions Subscription[]
  payments      Payment[]
  files         FileAsset[]
  auditLogs     AuditLog[]
  projects      Project[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model EmployeeHierarchy {
  id           String   @id @default(cuid())
  userId       String   @unique
  supervisorId String?
  managerId    String?
  level        String
  user         User     @relation("HierarchyUser", fields: [userId], references: [id], onDelete: Cascade)
  supervisor   User?    @relation("HierarchySupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  manager      User?    @relation("HierarchyManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([supervisorId])
  @@index([managerId])
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String?
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role?                    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status         OrganizationMemberStatus @default(INVITED)
  joinedAt       DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id             String               @id @default(cuid())
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String
  isSystem       Boolean              @default(false)
  members        OrganizationMember[]
  permissions    RolePermission[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([organizationId, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  data      Json?
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  description   String?
  priceMinor    Int
  currency      String         @default("SAR")
  billingPeriod String
  isActive      Boolean        @default(true)
  features      Json?
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)
  externalRef    String?            @unique
  currentStart   DateTime
  currentEnd     DateTime
  canceledAt     DateTime?
  payments       Payment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
  @@index([planId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountMinor    Int
  currency       String        @default("SAR")
  status         PaymentStatus @default(PENDING)
  provider       String?
  externalRef    String?       @unique
  paidAt         DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([subscriptionId])
}

model FileAsset {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String?
  uploadedBy     User?         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  storageKey     String        @unique
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  checksum       String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([uploadedById])
}

model Robot {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  team                    String?
  intelligence            Int                      @default(0)
  skill                   Int                      @default(0)
  experience              Int                      @default(0)
  status                  RobotStatus              @default(PENDING)
  isVisible               Boolean                  @default(false)
  notes                   String?
  tasks                   RobotTask[]
  reviews                 CommitteeReview[]
  missions                Mission[]
  evidence                Evidence[]
  costs                   CostRecord[]
  learningLogs            LearningLog[]
  evolutions              RobotEvolution[]
  modelRuns               ModelExecution[]
  genomeId                String?
  genome                  AgentGenome?             @relation(fields: [genomeId], references: [id], onDelete: SetNull)
  academicProfile         RobotAcademicProfile?
  runtimeAllocations      AgentRuntimeAllocation[]
  academyStaffAssignments AcademyStaffAssignment[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([status])
  @@index([isVisible])
}

model RobotTask {
  id                 String                   @id @default(cuid())
  robotId            String
  robot              Robot                    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             TaskStatus               @default(DRAFT)
  priority           String?                  @default("MEDIUM")
  dueAt              DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  missionId          String?
  mission            Mission?                 @relation(fields: [missionId], references: [id], onDelete: SetNull)
  evidence           Evidence[]
  costs              CostRecord[]
  learningLogs       LearningLog[]
  runtimeAllocations AgentRuntimeAllocation[]

  @@index([robotId, status])
}

model Mission {
  id                   String                   @id @default(cuid())
  name                 String
  description          String?
  status               TaskStatus               @default(DRAFT)
  requiredIntelligence Int                      @default(0)
  assignedRobots       Robot[]
  tasks                RobotTask[]
  costs                CostRecord[]
  evidence             Evidence[]
  learningLogs         LearningLog[]
  knowledgeEntries     SharedKnowledge[]
  runtimeAllocations   AgentRuntimeAllocation[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
}

model Evidence {
  id          String     @id @default(cuid())
  robotId     String
  robotTaskId String?
  missionId   String?
  type        String
  description String
  metadata    Json?
  verified    Boolean    @default(false)
  robot       Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  robotTask   RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: Cascade)
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([robotId, verified])
  @@index([robotTaskId])
  @@index([missionId])
}

model CostRecord {
  id                String     @id @default(cuid())
  robotId           String?
  robotTaskId       String?
  missionId         String?
  provider          String
  model             String?
  inputTokens       Int        @default(0)
  outputTokens      Int        @default(0)
  computeCostMinor  Int        @default(0)
  currency          String     @default("USD")
  estimatedDuration Int?
  actualDuration    Int?
  robot             Robot?     @relation(fields: [robotId], references: [id], onDelete: SetNull)
  robotTask         RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: SetNull)
  mission           Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())

  @@index([robotId, createdAt])
  @@index([missionId, createdAt])
}

model LearningLog {
  id          String     @id @default(cuid())
  robotId     String
  robotTaskId String?
  missionId   String?
  signal      String
  scoreBefore Int        @default(0)
  scoreAfter  Int        @default(0)
  feedback    String?
  robot       Robot      @relation(fields: [robotId], references: [id], onDelete: Cascade)
  robotTask   RobotTask? @relation(fields: [robotTaskId], references: [id], onDelete: SetNull)
  mission     Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([robotId, createdAt])
}

model RobotEvolution {
  id                String   @id @default(cuid())
  robotId           String
  generation        Int
  intelligenceDelta Int      @default(0)
  skillDelta        Int      @default(0)
  experienceDelta   Int      @default(0)
  reason            String
  robot             Robot    @relation(fields: [robotId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([robotId, generation])
  @@index([robotId, createdAt])
}

model SharedKnowledge {
  id                String              @id @default(cuid())
  title             String
  content           String
  source            String
  confidence        Int                 @default(0)
  missionId         String?
  mission           Mission?            @relation(fields: [missionId], references: [id], onDelete: SetNull)
  academyExperience AcademicExperience?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([confidence])
}

model ModelExecution {
  id           String   @id @default(cuid())
  robotId      String?
  provider     String
  model        String
  taskType     String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(false)
  robot        Robot?   @relation(fields: [robotId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([provider, model, createdAt])
}

model CommitteeReview {
  id        String        @id @default(cuid())
  robotId   String
  robot     Robot         @relation(fields: [robotId], references: [id], onDelete: Cascade)
  reviewer  String
  score     Int           @default(0)
  verdict   ReviewVerdict @default(DEFER)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([robotId, verdict])
}

model AgentGenome {
  id             String                     @id @default(cuid())
  name           String
  key            String                     @unique
  description    String?
  runtimeModel   String?
  robots         Robot[]
  skillPacks     AgentGenomeSkillPack[]
  knowledgePacks AgentGenomeKnowledgePack[]
  capabilities   AgentGenomeCapability[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
}

model SkillPack {
  id          String                 @id @default(cuid())
  name        String
  key         String                 @unique
  description String?
  genomes     AgentGenomeSkillPack[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model KnowledgePack {
  id          String                     @id @default(cuid())
  name        String
  key         String                     @unique
  description String?
  genomes     AgentGenomeKnowledgePack[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
}

model AgentGenomeSkillPack {
  genomeId    String
  skillPackId String
  genome      AgentGenome @relation(fields: [genomeId], references: [id], onDelete: Cascade)
  skillPack   SkillPack   @relation(fields: [skillPackId], references: [id], onDelete: Cascade)

  @@id([genomeId, skillPackId])
}

model AgentGenomeKnowledgePack {
  genomeId        String
  knowledgePackId String
  genome          AgentGenome   @relation(fields: [genomeId], references: [id], onDelete: Cascade)
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id], onDelete: Cascade)

  @@id([genomeId, knowledgePackId])
}

model Academy {
  id                String                     @id @default(cuid())
  name              String
  slug              String                     @unique
  description       String?
  fields            AcademyField[]
  courses           AcademyCourse[]
  colleges          AcademyCollege[]
  programs          AcademyProgram[]
  cohorts           AcademyCohort[]
  roles             AcademyRole[]
  curriculumChanges CurriculumChangeProposal[]
  workQueues        AcademyWorkQueue[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
}

model AcademyField {
  id              String              @id @default(cuid())
  academyId       String
  collegeId       String?
  name            String
  key             String
  description     String?
  academy         Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  college         AcademyCollege?     @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  disciplines     AcademyDiscipline[]
  specializations Specialization[]
  courses         AcademyCourse[]
  demands         WorkforceDemand[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([academyId, key])
}

model Specialization {
  id                 String                         @id @default(cuid())
  fieldId            String
  disciplineId       String?
  name               String
  key                String
  description        String?
  field              AcademyField                   @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  discipline         AcademyDiscipline?             @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  subSpecializations AcademySubspecialization[]
  skills             Skill[]
  courses            AcademyCourse[]
  exams              AcademyExam[]
  certifications     AcademyCertification[]
  primaryProfiles    RobotAcademicProfile[]         @relation("PrimarySpecialization")
  secondaryProfiles  RobotSecondarySpecialization[]
  demands            WorkforceDemand[]
  programs           AcademyProgram[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@unique([fieldId, key])
}

model Skill {
  id                        String                     @id @default(cuid())
  specializationId          String?
  parentSkillId             String?
  name                      String
  key                       String                     @unique
  description               String?
  riskLevel                 SkillRiskLevel             @default(LOW)
  specialization            Specialization?            @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  parentSkill               Skill?                     @relation("SkillHierarchy", fields: [parentSkillId], references: [id], onDelete: SetNull)
  subskills                 Skill[]                    @relation("SkillHierarchy")
  dependencies              SkillPrerequisite[]        @relation("SkillDependencies")
  requiredBy                SkillPrerequisite[]        @relation("SkillPrerequisites")
  courseLinks               CourseSkill[]
  certificationRequirements CertificationRequirement[]
  robotSkills               RobotSkill[]
  retrainingEvents          RetrainingEvent[]
  demands                   WorkforceDemand[]
  relationsFrom             SkillRelation[]            @relation("SkillRelationSource")
  relationsTo               SkillRelation[]            @relation("SkillRelationTarget")
  resourceRequirements      SkillResourceRequirement[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model SkillPrerequisite {
  skillId        String
  prerequisiteId String
  skill          Skill  @relation("SkillDependencies", fields: [skillId], references: [id], onDelete: Cascade)
  prerequisite   Skill  @relation("SkillPrerequisites", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([skillId, prerequisiteId])
}

model AcademyCourse {
  id                  String             @id @default(cuid())
  academyId           String
  fieldId             String?
  specializationId    String?
  curriculumVersionId String?
  title               String
  code                String
  description         String?
  academy             Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  field               AcademyField?      @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  specialization      Specialization?    @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  lessons             AcademyLesson[]
  labs                AcademyLab[]
  exams               AcademyExam[]
  skills              CourseSkill[]
  completions         CourseCompletion[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([academyId, code])
}

