DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:54329/jenanbiz?schema=public"
POSTGRES_DB="jenanbiz"
POSTGRES_USER="jenanbiz_app"
POSTGRES_PASSWORD=""
POSTGRES_PORT="54329"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Vercel) uses the official domain https://jenanpro.sa; set it as NEXT_PUBLIC_APP_URL there. A production deployment without it falls back to that domain.
SITE_ACCESS_USERNAME=""
SITE_ACCESS_PASSWORD=""
# Serves a production deployment that has no private gate. Leave empty while the site is private; set to "approved" only for the public launch.
PUBLIC_LAUNCH=""
# Set these with an approved, licensed tile provider in production. The app falls back to OpenStreetMap when unset.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""
NEXT_PUBLIC_MAP_PROVIDER_LABEL=""
AUTH_SECRET=""
ALLOW_PUBLIC_REGISTRATION="false"
# E-mail (Resend): verification codes, password recovery and project invitations. See docs/email-setup.md and run `npm run mail:check`.
# MAIL_FROM must use a domain that is verified in Resend (SPF + DKIM), for example: Jenan PRO <no-reply@jenanpro.sa>
RESEND_API_KEY=""
MAIL_FROM=""
MAIL_REPLY_TO=""
# The older recovery-only sender still works when MAIL_FROM is empty.
AUTH_RECOVERY_EMAIL_FROM=""
AUTH_RECOVERY_EMAIL_ENDPOINT="https://api.resend.com/emails"
# Sensitive actions (accepting invitations, inviting people, publishing listings and postings, paying for campaigns) need a verified
# address. Empty means: required once PUBLIC_LAUNCH=approved, otherwise off. Set "true" for the invited trial group.
REQUIRE_EMAIL_VERIFICATION=""
# Social sign-in (optional). A provider's button turns on only when ALL of its values are set (and AUTH_SECRET exists).
# Register these redirect URIs with the provider: <NEXT_PUBLIC_APP_URL>/api/auth/oauth/google/callback and <NEXT_PUBLIC_APP_URL>/api/auth/oauth/apple/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple "Services ID" (web), your Team ID, the Key ID of the Sign in with Apple key, and that key's .p8 contents (use \n for line breaks).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
METRICS_TOKEN=""
REDIS_URL=""
REDIS_PASSWORD=""
REDIS_PORT="6379"
# Vercel injects BLOB_STORE_ID and VERCEL_OIDC_TOKEN when a Blob store is linked.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
APP_PORT="3000"
# Optional resilience limits (defaults shown in docs/load-testing.md): concurrent Argon2 hashes per instance and the waiting line
# before sign-in answers 503, the database pool size per instance, and the connection and statement timeouts.
# PASSWORD_HASH_CONCURRENCY="4"
# PASSWORD_HASH_QUEUE="24"
# DATABASE_POOL_MAX="20"
# DATABASE_CONNECT_TIMEOUT_MS="8000"
# DATABASE_QUERY_TIMEOUT_MS="30000"
BACKUP_INTERVAL_SECONDS="86400"
BACKUP_RETENTION_DAYS="14"
SUPER_ADMIN_EMAIL=""
# Prefer leaving SUPER_ADMIN_PASSWORD empty: an interactive run then generates a password and shows it once (see README).
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_DISPLAY_NAME=""
SUPER_ADMIN_LOCALE="en"
SUPER_ADMIN_COUNTRY_CODE="SA"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
LLAMA_API_URL=""
LLAMA_API_KEY=""
LLAMA_MODEL="llama"
