DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:54329/jenanbiz?schema=public"
POSTGRES_DB="jenanbiz"
POSTGRES_USER="jenanbiz_app"
POSTGRES_PASSWORD=""
POSTGRES_PORT="54329"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set these with an approved, licensed tile provider in production. The app falls back to OpenStreetMap when unset.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""
NEXT_PUBLIC_MAP_PROVIDER_LABEL=""
AUTH_SECRET=""
# Keep production registration closed until mailbox verification is operational.
# Organization invitation acceptance requires User.emailVerifiedAt; registration does not set it.
ALLOW_PUBLIC_REGISTRATION="false"
# Configure a real email provider in production; development-only reset codes are not a delivery mechanism.
AUTH_RECOVERY_EMAIL_FROM=""
AUTH_RECOVERY_EMAIL_ENDPOINT="https://api.resend.com/emails"
RESEND_API_KEY=""
METRICS_TOKEN=""
# Production authentication fails closed without Redis. Ingress must overwrite forwarded client-IP headers.
REDIS_URL=""
REDIS_PASSWORD=""
REDIS_PORT="6379"
APP_PORT="3000"
BACKUP_INTERVAL_SECONDS="86400"
BACKUP_RETENTION_DAYS="14"
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_DISPLAY_NAME=""
SUPER_ADMIN_LOCALE="en"
SUPER_ADMIN_COUNTRY_CODE="SA"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
LLAMA_API_URL=""
LLAMA_API_KEY=""
LLAMA_MODEL="llama"
